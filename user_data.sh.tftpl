#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/terraform-controller-user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y unzip curl ca-certificates

# Install Terraform from HashiCorp's official Linux repository.
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /etc/apt/keyrings/hashicorp-archive-keyring.gpg
chmod 0644 /etc/apt/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(. /etc/os-release && echo "$$VERSION_CODENAME") main" > /etc/apt/sources.list.d/hashicorp.list
apt-get update
apt-get install -y terraform

install -d -o ubuntu -g ubuntu -m 0755 /home/ubuntu/secondary-infra
cat > /home/ubuntu/secondary-infra/main.tf <<'TF_EOF'
${nested_main_tf}
TF_EOF
chown ubuntu:ubuntu /home/ubuntu/secondary-infra/main.tf
chmod 0644 /home/ubuntu/secondary-infra/main.tf

cat > /home/ubuntu/secondary-infra/README.txt <<'README_EOF'
Nested Terraform test:
  cd /home/ubuntu/secondary-infra
  terraform init
  terraform plan
  terraform apply

After testing, destroy the nested bucket first:
  terraform destroy

Then leave the EC2 controller and run terraform destroy from your Windows project directory to remove outer resources.
README_EOF
chown ubuntu:ubuntu /home/ubuntu/secondary-infra/README.txt
